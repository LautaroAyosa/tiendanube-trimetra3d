<section class="section-sale-video-home section-sale-video-home-help" data-store="home-products-sale-video">
	<div class="container">
		<div class="sale-video-shell">
			<div class="sale-video-media">
				<div class="sale-video-help-frame">
					<div class="sale-video-help-icon" aria-hidden="true">
						{% include "snipplets/svg/play.tpl" with {svg_custom_class: "icon-inline icon-lg svg-icon-invert"} %}
					</div>
					<span>9:16</span>
				</div>
			</div>
			<div class="sale-video-products sale-video-help-copy">
				<div class="sale-video-kicker">{{ 'Ofertas en movimiento' | translate }}</div>
				<h2 class="sale-video-title h3">{{ 'Video vertical + carrusel de productos' | translate }}</h2>
				<p>{{ 'Cargá un video MP4 o WebM y elegí los productos de la sección Ofertas para mostrar este bloque.' | translate }}</p>
				<a href="/admin/themes/settings/product_order/" target="_top" class="btn-link">{{ 'Elegir productos en oferta' | translate }}</a>
			</div>
		</div>
	</div>
</section>
